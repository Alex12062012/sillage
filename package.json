{
  "name": "sillage",
  "version": "0.1.0",
  "private": true,
  "description": "Sillage — a low-poly 3D skiing game about speed and the joy of carving. Runs in the browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4180 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "feel": "vitest run tests/unit/feel.test.ts"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
